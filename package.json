  "scripts": {
    "build": "esbuild src/field.js --bundle --minify --format=esm --target=es2020 --outfile=assets/field.js",
    "land": "node tools/build_land.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "three": "0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
